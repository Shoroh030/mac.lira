<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:label="Вместе"
        android:icon="@drawable/ic_together"
        android:roundIcon="@drawable/ic_together"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vmeste">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WatchPartyActivity" android:exported="false" />
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <service android:name=".ScreenShareService" android:exported="false" android:foregroundServiceType="mediaProjection|microphone" />
    </application>
</manifest>
