<resources>
    <style name="Theme.Vmeste" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#8158A5</item>
        <item name="android:editTextStyle">@style/Widget.Vmeste.EditText</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Vmeste.Dialog</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FBF8FC</item>
    </style>

    <style name="ThemeOverlay.Vmeste.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#8158A5</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:textColorPrimary">#302B35</item>
        <item name="android:textColorSecondary">#6E6575</item>
    </style>

    <style name="ThemeOverlay.Vmeste.Dialog.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#D0B3E9</item>
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
        <item name="android:backgroundDimAmount">0.48</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:textColorPrimary">#F2EDF5</item>
        <item name="android:textColorSecondary">#B8ACBF</item>
    </style>

    <style name="Widget.Vmeste.EditText" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_dialog_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">#302B35</item>
        <item name="android:textColorHint">#6E6575</item>
    </style>
</resources>
